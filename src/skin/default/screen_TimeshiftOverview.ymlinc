screen:
  name: "TimeshiftOverview"
  position: "center,center"
  size: "1200,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        position: "20,75"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "$screen_width-40,($screen_height-2*55-40)/70*70"
        source: "list"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_TimeshiftOverviewList.ymlinc"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
