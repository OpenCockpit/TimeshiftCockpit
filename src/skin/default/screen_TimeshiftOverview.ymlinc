screen:
  backgroundColor: "md_transparent"
  name: "TimeshiftOverview"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Medium.ymlinc"
        position: "370,111"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "20,72"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "1140,700"
        source: "list"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_TimeshiftOverviewList.ymlinc"
