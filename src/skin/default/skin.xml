		</widget>
		<widget font="Regular;26" foregroundColor="white" halign="center" position="150,1013" render="Label" size="368,45" source="session.CurrentService" transparent="1" valign="center" zPosition="2">
			<convert type="COCServiceInfo">VideoInfo</convert>
