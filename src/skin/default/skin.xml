		</widget>
		<eLabel backgroundColor="backgroundLight" position="30,971" size="1860,10" zPosition="0"/>
		<widget alphatest="blend" foregroundColor="yellow" position="30,971" render="Progress" size="1860,10" source="Service" transparent="1" zPosition="2">
			<convert type="COCServicePosition">Position</convert>
		</widget>
		<widget alphatest="blend" foregroundColor="darkgrey" position="30,971" render="Progress" size="1860,10" source="Service" transparent="1" zPosition="3">
			<convert type="COCBeforeTSPosition">Position</convert>
		</widget>
		<widget alphatest="blend" foregroundColor="red" position="30,971" render="Progress" size="1860,10" source="Service" transparent="1" zPosition="1">
			<convert type="COCRecordPosition">Position</convert>
		</widget>
	</screen>
	<screen name="CockpitPlayerSummary" position="fill" resolution="396,240">
