		</widget>
		<ePixmap name="player_icon" pixmap="~/../images/player.svg" position="30,893" size="60,60" zPosition="2"/>
		<widget font="Regular;42" noWrap="1" position="105,900" render="Label" size="1600,50" source="Service" transparent="1">
