convert:
  type: "COCTemplatedMultiContentEx"
  cell:
    vars:
      - "ih = 70"
      - "hspace = 10"
      - "thumb_w = ih*2-10"
      - "thumb_h = ih-10"
      - "x1 = hspace//2+thumb_w+hspace"
      - "col3_w = ih*3"
      - "col2_w = (e-x1)//4"
      - "x3 = e-col3_w-hspace//2"
      - "x2 = x3-col2_w-hspace"
      - "col1_w = x2-x1-hspace"
    itemHeight: ih
    fonts:
      - "$md_body_small"
    fields:
      - icon:
          position: "hspace//2,(ih-thumb_h)//2"
          size: "thumb_w,thumb_h"
          flags: BT_SCALE|BT_KEEP_ASPECT_RATIO
          value: 0
          variant: "AlphaTest"
          backcolor: null
      - text:
          position: "x1,0"
          size: "col1_w,ih"
          flags: RT_VALIGN_CENTER
          value: 1
      - text:
          position: "x2,0"
          size: "col2_w,ih"
          flags: RT_VALIGN_CENTER
          value: 2
      - text:
          position: "x3,0"
          size: "col3_w,ih"
          flags: RT_VALIGN_CENTER|RT_HALIGN_RIGHT
          value: 3
